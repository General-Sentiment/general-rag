{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quarter",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-18",
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "quarter.page",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "QuarterContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUARTER_CONTAINER",
        "class_name": "QuarterContainer"
      }
    ]
  },
  "exports": {
    "GeneralRagContainer": {
      "type": "durable-object",
      "state": "deleted"
    },
    "QuarterContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
