{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quarter",
  "version": "0.1.0",
  "identifier": "org.generalsentiment.quarter",
  "build": {
    "frontendDist": "../desktop-static",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quarter",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
